# Demo 使用固定规则，不调用模型。
APP_MODE=demo
DATABASE_URL=sqlite:///./data/app.db
CHECKPOINT_URL=./data/checkpoints.db

# Live 模式需要兼容 Chat Completions 和 function/tool calling 的服务商。
# 不同模型支持的字段不同，需实际验证。
# 地址填写 API 根路径，例如 /v1；不要填写 /chat/completions。
LLM_PROVIDER=generic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAX_MODEL_ROUNDS=6
MAX_TOOL_CALLS=10
REQUEST_TIMEOUT=30

# 可选的共享控制台令牌，不是多用户认证。
# 若不再只绑定 localhost，请先配置。浏览器仅在当前会话保存令牌。
CONSOLE_TOKEN=

# DeepSeek 非思考模式的 function calling：
# APP_MODE=live
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=your-local-secret
# REQUEST_TIMEOUT=60
